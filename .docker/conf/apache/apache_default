<VirtualHost *:80>
    ServerAdmin webmaster@localhost

    DocumentRoot /www/default/public
    <Directory /www/default/public>
        AllowOverride All

        Require all granted
        Allow from All

        <IfModule mod_rewrite.c>
            Options -MultiViews
            RewriteEngine On
            RewriteCond %{REQUEST_FILENAME} !-f
            RewriteRule ^(.*)$ index.php [QSA,L]
        </IfModule>
    </Directory>


    ErrorLog /dev/stdout
    CustomLog /dev/stdout combined
</VirtualHost>
